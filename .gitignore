# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*~

# ─── Editors / IDEs ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.*.sw[a-p]
.history/

# ─── Test tooling (vendored on demand by tests/vendor.sh) ────────────────────
tests/.vendor/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─── Temp / Caches ───────────────────────────────────────────────────────────
*.tmp
*.temp
.tmp/
.cache/
*.bak
*.orig

# ─── Claude Code (local-only state) ──────────────────────────────────────────
.claude/settings.local.json
.claude/sessions/
.claude/.tmp/

# ─── BMAD personal config (per-contributor, never shared) ────────────────────
_bmad/config.user.yaml
_bmad/custom/*.user.toml

# ─── BMAD runtime state (regenerable, project-local) ─────────────────────────
_bmad-output/.stepper/
_bmad-output/.archive/
_bmad-output/.runs/
