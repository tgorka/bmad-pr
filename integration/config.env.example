# bmad-pr project configuration — copy to {project-root}/_bmad/bmad-pr/config.env
# Flat shell KEY=value; environment variables override this file; CLI flags
# override both. Commented lines show the defaults.

# PR backend: auto detects gt (only when `gt init` ran in the repo), then gh,
# then falls back to bare git (push + manual-PR instructions).
#BMAD_PR_TOOL=auto

# Trunk branch PRs ultimately target.
#BMAD_PR_TRUNK=main

# Open PRs as drafts (true) or ready for review (false).
#BMAD_PR_DRAFT=true

# Where story→PR ledgers and findings files live (relative to repo root).
#BMAD_PR_LEDGER_DIR=_bmad-output/pr

# Git-safety scope: unstaged changes outside this path refuse the run (CH3).
#BMAD_PR_STAGE_GLOB=_bmad-output/

# Story branches are named <prefix>/story/<key>.
#BMAD_PR_BRANCH_PREFIX=bmad

# AI reviewer provider: cubic | generic | none.
#BMAD_PR_REVIEWER=cubic

# Provider profile overrides (cubic defaults shown; set all of these when
# using BMAD_PR_REVIEWER=generic — e.g. CodeRabbit:
#   BOT_REGEX='^coderabbitai' TRIGGER='@coderabbitai review' COMPLETION=bot-review).
#BMAD_PR_REVIEWER_BOT_REGEX=^cubic
#BMAD_PR_REVIEWER_CHECK_REGEX=^cubic
#BMAD_PR_REVIEWER_TRIGGER=@cubic-dev re-review
#BMAD_PR_REVIEWER_COMPLETION=check-run
#BMAD_PR_SCORE_REGEX=PR score: ([0-9]+)/10

# A completed review scoring below this (and not approved) counts as findings.
#BMAD_PR_SCORE_THRESHOLD=8

# watch deadline (seconds) and initial poll interval (backs off to 60s).
#BMAD_PR_TIMEOUT=1800
#BMAD_PR_POLL_INTERVAL=15

# How long after a push to keep waiting for check suites to register before
# trusting a "no checks" or "all green" verdict (fail is always immediate).
#BMAD_PR_REGISTER_GRACE=90

# Ceiling for the /bmad-pr-loop address→re-review cycle.
#BMAD_PR_MAX_ITERATIONS=5
